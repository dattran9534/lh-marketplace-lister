{
  "manifest_version": 3,
  "name": "LH Marketplace Lister",
  "version": "1.5.2",
  "description": "Import vehicles from lynnwoodhonda.com and autofill Facebook Marketplace \"Vehicle for sale\" listings.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LH Marketplace Lister",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://www.lynnwoodhonda.com/*",
    "https://lynnwoodhonda.com/*",
    "https://content.homenetiol.com/*",
    "https://www.facebook.com/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["imageproc.js", "fb-content.js"],
      "css": ["fb-content.css"],
      "run_at": "document_idle"
    }
  ]
}
